<resources xmlns:tools="http://schemas.android.com/tools" xmlns:android="http://schemas.android.com/apk/res/android">

    <style name="Base.Theme.CatMap" parent="Theme.Material3.DayNight.NoActionBar">
    </style>

    <style name="MapsTheme" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowBackground">@android:color/white</item>
        <item name="android:windowNoTitle">true</item>
    </style>

    <style name="CatMapDialogTheme" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="windowNoTitle">true</item>
    </style>

    <style name="Theme.CatMap" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/catmap_primary</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorContainer">#FAFAFA</item>

        <item name="colorAccent">@color/catmap_accent</item>
        <item name="colorSecondary">@color/catmap_accent</item>
        <item name="colorOnSecondary">#FFFFFF</item>

        <item name="colorSecondaryContainer">#26FF6F00</item>

        <item name="android:windowBackground">#FAFAFA</item>
        <item name="colorSurface">#FFFFFF</item>
        <item name="colorOnSurface">#222222</item>

        <item name="android:statusBarColor">#FAFAFA</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">true</item>
        <item name="android:navigationBarColor">#FFFFFF</item>

        <item name="textInputStyle">@style/Widget.CatMap.TextInputLayout</item>
        <item name="materialButtonStyle">@style/Widget.CatMap.Button</item>
    </style>

    <style name="Theme.CatMap.BottomNavOverlay" parent="">
        <item name="colorSecondaryContainer">@android:color/transparent</item>
        <item name="colorControlHighlight">#1AF97316</item>

        <item name="itemRippleColor">@android:color/transparent</item>
    </style>

    <style name="Widget.CatMap.TextInputLayout" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">14dp</item>
        <item name="boxCornerRadiusTopEnd">14dp</item>
        <item name="boxCornerRadiusBottomStart">14dp</item>
        <item name="boxCornerRadiusBottomEnd">14dp</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxStrokeWidthFocused">1.5dp</item>
        <item name="boxStrokeColor">@color/selector_text_input_stroke</item>
        <item name="hintTextColor">@color/catmap_accent</item>
        <item name="android:textColorHint">#A0A0A0</item>
    </style>

    <style name="Widget.CatMap.Button" parent="Widget.Material3.Button">
        <item name="cornerRadius">14dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:fontFamily">sans-serif-condensed-bold</item>
    </style>

</resources>