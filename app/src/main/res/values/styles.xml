<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="ModernAlertDialog" parent="Theme.AppCompat.Light.Dialog.Alert">
        <item name="android:background">#FAFAFA</item>
        <item name="android:windowMinWidthMajor">90%</item>
        <item name="android:windowMinWidthMinor">90%</item>
        <item name="android:textColor">#212121</item>
    </style>


    <style name="CatMapGridImageShape">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">4dp</item>
    </style>

    <style name="CatMapThumbImageShape">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">10dp</item>
    </style>

    <style name="CatMapPremiumThumbShape">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">8dp</item>
    </style>

    <style name="Dialog.FullWidth" parent="Theme.MaterialComponents.Light.BottomSheetDialog">
        <item name="android:windowIsFloating">false</item>
        <item name="android:windowSoftInputMode">adjustResize</item>
        <item name="bottomSheetStyle">@style/CustomBottomSheetStyle</item>


        <item name="android:windowAnimationStyle">@style/BottomSheetAnimation</item>
    </style>

    <style name="ShapeAppearance.BottomSheet.Rounded" parent="ShapeAppearance.MaterialComponents.LargeComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">28dp</item>
        <item name="cornerSizeTopRight">28dp</item>
    </style>

    <style name="CustomBottomSheetStyle" parent="Widget.MaterialComponents.BottomSheet.Modal">
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.BottomSheet.Rounded</item>
        <item name="backgroundTint">@android:color/white</item>
        <item name="shouldRemoveExpandedCorners">false</item>
    </style>

    <style name="BottomSheetAnimation">
        <item name="android:windowEnterAnimation">@anim/bottom_sheet_enter</item>
        <item name="android:windowExitAnimation">@anim/bottom_sheet_exit</item>
    </style>

    <style name="ShapeAppearance.Catmap.OvalFAB" parent="ShapeAppearance.Material3.Corner.Full">
        <item name="cornerSize">50%</item>
        <item name="cornerSizeTopLeft">50%</item>
        <item name="cornerSizeTopRight">50%</item>
        <item name="cornerSizeBottomLeft">50%</item>
        <item name="cornerSizeBottomRight">50%</item>
    </style>
</resources>
