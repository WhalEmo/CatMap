<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/catmap_surface_white"
    android:orientation="vertical">

    <!-- ====================================================== -->
    <!-- DRAG HANDLE                                            -->
    <!-- ====================================================== -->

    <View
        android:layout_width="42dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="4dp"
        android:background="@drawable/bg_bottom_sheet_handle" />


    <!-- ====================================================== -->
    <!-- SCROLLABLE CONTENT                                     -->
    <!-- ====================================================== -->

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollBadgeDetail"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="16dp"
            android:paddingEnd="20dp"
            android:paddingBottom="28dp">


            <!-- ====================================================== -->
            <!-- BADGE HERO                                             -->
            <!-- ====================================================== -->

            <FrameLayout
                android:id="@+id/layoutBadgeHero"
                android:layout_width="132dp"
                android:layout_height="132dp"
                android:layout_gravity="center_horizontal">

                <!-- Hafif arka halo -->
                <View
                    android:id="@+id/viewBadgeGlow"
                    android:layout_width="112dp"
                    android:layout_height="112dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_badge_detail_glow" />

                <ImageView
                    android:id="@+id/imgBadge"
                    android:layout_width="110dp"
                    android:layout_height="110dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:scaleType="fitCenter"
                    tools:src="@drawable/catmap_badge_tier_06" />

                <!-- Kilit -->
                <ImageView
                    android:id="@+id/imgBadgeLock"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_gravity="bottom|end"
                    android:layout_marginEnd="7dp"
                    android:layout_marginBottom="7dp"
                    android:background="@drawable/bg_lock_badge_circle"
                    android:padding="7dp"
                    android:src="@drawable/ic_lock"
                    android:visibility="gone"
                    app:tint="@color/badge_ink"
                    tools:visibility="visible" />

            </FrameLayout>


            <!-- ====================================================== -->
            <!-- LOCATION                                               -->
            <!-- ====================================================== -->

            <TextView
                android:id="@+id/tvBadgeLocation"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="8dp"
                android:fontFamily="@font/plus_jakarta_sans_medium"
                android:gravity="center"
                android:includeFontPadding="false"
                android:textColor="@color/catmap_text_secondary"
                android:textSize="12sp"
                tools:text="Selçuklu • Yazır Mahallesi" />


            <!-- ====================================================== -->
            <!-- CONTEXTUAL BADGE TITLE                                 -->
            <!-- ====================================================== -->

            <TextView
                android:id="@+id/tvBadgeTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:fontFamily="@font/plus_jakarta_sans_bold"
                android:gravity="center"
                android:includeFontPadding="false"
                android:textColor="@color/catmap_text_primary"
                android:textSize="22sp"
                tools:text="Yazır'ın Mahalle Öncüsü" />


            <!-- ====================================================== -->
            <!-- ELEMENT + LEVEL                                        -->
            <!-- ====================================================== -->

            <LinearLayout
                android:id="@+id/layoutBadgeMeta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:orientation="horizontal">

                <!-- ELEMENT -->
                <TextView
                    android:id="@+id/tvBadgeElement"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_badge_meta_pill"
                    android:fontFamily="@font/plus_jakarta_sans_bold"
                    android:includeFontPadding="false"
                    android:paddingHorizontal="11dp"
                    android:paddingVertical="6dp"
                    android:textColor="@color/catmap_accent"
                    android:textSize="11sp"
                    tools:text="ALTIN ROZETİ" />

                <!-- LEVEL -->
                <TextView
                    android:id="@+id/tvBadgeLevel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="7dp"
                    android:background="@drawable/bg_badge_meta_pill"
                    android:fontFamily="@font/plus_jakarta_sans_bold"
                    android:includeFontPadding="false"
                    android:paddingHorizontal="11dp"
                    android:paddingVertical="6dp"
                    android:textColor="@color/catmap_accent"
                    android:textSize="11sp"
                    tools:text="SEVİYE 6" />

            </LinearLayout>


            <!-- ====================================================== -->
            <!-- SHORT DESCRIPTION                                      -->
            <!-- ====================================================== -->

            <TextView
                android:id="@+id/tvShortDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:fontFamily="@font/plus_jakarta_sans_bold"
                android:gravity="center"
                android:includeFontPadding="false"
                android:lineSpacingExtra="3dp"
                android:textColor="@color/catmap_text_primary"
                android:textSize="15sp"
                tools:text="Artık haritayı takip edenlerden değil, onu büyütenlerden birisin." />


            <!-- ====================================================== -->
            <!-- STORY DIVIDER                                          -->
            <!-- ====================================================== -->

            <View
                android:layout_width="48dp"
                android:layout_height="2dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="18dp"
                android:layout_marginBottom="18dp"
                android:background="@color/catmap_accent" />


            <!-- ====================================================== -->
            <!-- STORY HEADER                                           -->
            <!-- ====================================================== -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/plus_jakarta_sans_bold"
                android:includeFontPadding="false"
                android:text="Rozetin Hikâyesi"
                android:textColor="@color/catmap_text_primary"
                android:textSize="14sp" />


            <!-- ====================================================== -->
            <!-- STORY                                                  -->
            <!-- ====================================================== -->

            <TextView
                android:id="@+id/tvBadgeStory"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="9dp"
                android:fontFamily="@font/plus_jakarta_sans"
                android:includeFontPadding="false"
                android:lineSpacingExtra="5dp"
                android:textColor="@color/catmap_text_secondary"
                android:textSize="13sp"
                tools:text="Her mahallede birileri ilk adımı atar. Yeni kedileri keşfeden, boş kalan bölgeleri CatMap'e kazandıran ve eski profillere yeni izler bırakan kullanıcılar zamanla mahallenin haritadaki yüzünü oluşturur.&#10;&#10;Mahalle Öncüsü olarak yaptığın katkılar artık tek tek keşiflerin ötesine geçiyor." />


            <!-- ====================================================== -->
            <!-- TAGS                                                   -->
            <!-- ====================================================== -->

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipGroupTags"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                app:chipSpacingHorizontal="7dp"
                app:chipSpacingVertical="7dp"
                app:singleLine="false">

                <!-- Runtime'da doldurulacak -->

                <com.google.android.material.chip.Chip
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checkable="false"
                    android:clickable="false"
                    android:text="Liderlik"
                    android:visibility="gone"
                    tools:visibility="visible"
                    app:chipBackgroundColor="@color/catmap_background"
                    app:chipCornerRadius="50dp"
                    app:chipMinHeight="32dp"
                    app:chipStrokeColor="@color/catmap_divider"
                    app:chipStrokeWidth="1dp" />

            </com.google.android.material.chip.ChipGroup>


            <!-- ====================================================== -->
            <!-- PROGRESS / ACHIEVEMENT CARD                            -->
            <!-- ====================================================== -->

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardBadgeProgress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                app:cardBackgroundColor="@color/catmap_background"
                app:cardCornerRadius="18dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/catmap_divider"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">


                    <!-- Progress header -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvProgressTitle"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:fontFamily="@font/plus_jakarta_sans_bold"
                            android:includeFontPadding="false"
                            android:textColor="@color/catmap_text_primary"
                            android:textSize="13sp"
                            tools:text="Rozet İlerlemesi" />

                        <TextView
                            android:id="@+id/tvCatProgress"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/plus_jakarta_sans_bold"
                            android:includeFontPadding="false"
                            android:textColor="@color/catmap_accent"
                            android:textSize="13sp"
                            tools:text="18 / 25" />

                    </LinearLayout>


                    <!-- Progress bar -->
                    <ProgressBar
                        android:id="@+id/progressBadge"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="7dp"
                        android:layout_marginTop="12dp"
                        android:max="100"
                        android:progressDrawable="@drawable/bg_custom_progress_bar"
                        tools:progress="72" />


                    <!-- Progress explanation -->
                    <TextView
                        android:id="@+id/tvProgressDescription"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="9dp"
                        android:fontFamily="@font/plus_jakarta_sans_medium"
                        android:includeFontPadding="false"
                        android:textColor="@color/catmap_text_secondary"
                        android:textSize="11sp"
                        tools:text="Mahalle Öncüsü rozetini açmak için 7 kedi daha keşfet." />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>


            <!-- ====================================================== -->
            <!-- UNLOCK STATUS                                          -->
            <!-- ====================================================== -->

            <LinearLayout
                android:id="@+id/layoutUnlockedStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_badge_unlocked_status"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="14dp"
                android:visibility="gone"
                tools:visibility="visible">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_check"
                    app:tint="@color/catmap_success" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="11dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/plus_jakarta_sans_bold"
                        android:includeFontPadding="false"
                        android:text="Rozet Kazanıldı"
                        android:textColor="@color/catmap_text_primary"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/tvUnlockedDescription"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:fontFamily="@font/plus_jakarta_sans"
                        android:includeFontPadding="false"
                        android:textColor="@color/catmap_text_secondary"
                        android:textSize="11sp"
                        tools:text="Bu rozet Yazır Mahallesi'ndeki katkılarınla kazanıldı." />

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <LinearLayout
        android:id="@+id/layoutBadgeAction"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/catmap_surface_white"
        android:elevation="4dp"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="9dp"
        android:visibility="gone"
        tools:visibility="visible">

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginBottom="6dp"
            android:background="@color/catmap_divider" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnUseBadge"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:fontFamily="@font/plus_jakarta_sans_bold"
            android:gravity="center"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="@string/badge_use_action"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="14sp"
            app:cornerRadius="16dp"
            tools:backgroundTint="@color/badge_tier_07_ui_accent" />

    </LinearLayout>

</LinearLayout>