<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="top|center_horizontal"
    android:orientation="vertical"
    android:paddingStart="32dp"
    android:paddingTop="24dp"
    android:paddingEnd="32dp"
    android:paddingBottom="16dp">

    <FrameLayout
        android:layout_width="280dp"
        android:layout_height="280dp"
        android:layout_marginBottom="24dp"
        android:padding="12dp"
        android:clipChildren="false"
        android:clipToPadding="false">

        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_onboarding_circle"
            android:elevation="6dp"
            android:outlineProvider="background" />

        <!-- 2. Ön Plandaki Animasyonlar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:elevation="8dp">

            <com.airbnb.lottie.LottieAnimationView
                android:id="@+id/animationView"
                android:layout_width="140dp"
                android:layout_height="140dp"
                app:lottie_autoPlay="true"
                app:lottie_loop="true"
                app:lottie_rawRes="@raw/like" />

            <com.airbnb.lottie.LottieAnimationView
                android:id="@+id/animationView2"
                android:layout_width="160dp"
                android:layout_height="120dp"
                android:layout_marginTop="-40dp"
                app:lottie_autoPlay="true"
                app:lottie_loop="true"
                app:lottie_rawRes="@raw/chatmessage" />

        </LinearLayout>
    </FrameLayout>

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:gravity="center"
        android:text="Haritada Kedileri Keşfet!"
        android:textColor="@color/catmap_text_primary"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvDescription"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:lineSpacingExtra="6dp"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:text="Çevrendeki sokak kedilerini harita üzerinde canlı olarak gör, nerede olduklarını ve ne zaman beslendiklerini hemen öğren."
        android:textColor="@color/catmap_text_muted"
        android:textSize="15sp" />

</LinearLayout>