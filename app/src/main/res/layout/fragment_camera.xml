<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://tools.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <androidx.camera.view.PreviewView
        android:id="@+id/viewFinder"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:scaleType="fillCenter" />

    <ImageView
        android:id="@+id/ivInFragmentPreview"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitCenter"
        android:alpha="0.0"
        android:visibility="gone"
        android:background="@android:color/black" />

    <View
        android:id="@+id/viewTopGradient"
        android:layout_width="match_parent"
        android:layout_height="140dp"
        android:background="@drawable/bg_camera_top_gradient"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageButton
        android:id="@+id/btnClose"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:padding="12dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:src="@drawable/ic_close"
        app:tint="@android:color/white"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tvAppName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="CatMap"
        android:textColor="@android:color/white"
        android:textSize="22sp"
        android:fontFamily="sans-serif-condensed-bold"
        android:letterSpacing="0.06"
        android:shadowColor="#80000000"
        android:shadowDx="0"
        android:shadowDy="4"
        android:shadowRadius="6"
        app:layout_constraintBottom_toBottomOf="@+id/btnClose"
        app:layout_constraintEnd_toStartOf="@+id/btnConfirmAll"
        app:layout_constraintStart_toEndOf="@+id/btnClose"
        app:layout_constraintTop_toTopOf="@+id/btnClose" />

    <ImageButton
        android:id="@+id/btnConfirmAll"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="16dp"
        android:padding="12dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:src="@drawable/ic_check"
        android:clickable="false"
        android:focusable="false"
        app:tint="#40FFFFFF"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <LinearLayout
        android:id="@+id/layoutPreviewMenu"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="24dp"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="gone"
        android:elevation="7dp"
        app:layout_constraintBottom_toTopOf="@+id/recyclerViewFilmStrip"
        app:layout_constraintEnd_toEndOf="parent"
        tools:visibility="visible">

        <ImageButton
            android:id="@+id/btnMenuRemoveFromStrip"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_delete_circle_alpha"
            android:src="@drawable/ic_close"
            android:elevation="2dp"
            app:tint="@color/catmap_text_light" />

        <ImageButton
            android:id="@+id/btnMenuApprove"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_delete_circle_alpha"
            android:src="@drawable/ic_check"
            android:elevation="2dp"
            app:tint="@color/catmap_success" />

    </LinearLayout>

    <View
        android:id="@+id/viewBottomGradient"
        android:layout_width="match_parent"
        android:layout_height="180dp"
        android:background="@drawable/bg_camera_bottom_gradient"
        app:layout_constraintBottom_toBottomOf="parent" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerViewFilmStrip"
        android:layout_width="match_parent"
        android:layout_height="84dp"
        android:layout_marginBottom="12dp"
        android:clipToPadding="false"
        android:paddingHorizontal="8dp"
        android:orientation="horizontal"
        android:elevation="2dp"
        app:layout_constraintBottom_toTopOf="@+id/btnCaptureLayout"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        tools:listitem="@layout/item_film_strip" />

    <FrameLayout
        android:id="@+id/btnCaptureLayout"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:layout_marginBottom="36dp"
        android:clickable="true"
        android:focusable="true"
        android:elevation="6dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <View
            android:id="@+id/viewCaptureOuter"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_instagram_capture_outer" />

        <View
            android:id="@+id/btnCapture"
            android:layout_width="58dp"
            android:layout_height="58dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_instagram_capture_inner" />
    </FrameLayout>

    <ImageButton
        android:id="@+id/btnGallery"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:padding="12dp"
        android:elevation="6dp"
        android:scaleType="fitCenter"
        android:clickable="true"
        android:focusable="true"
        android:background="@drawable/bg_instagram_secondary_btn"
        android:src="@drawable/ic_gallery"
        app:tint="@android:color/white"
        app:layout_constraintBottom_toBottomOf="@+id/btnCaptureLayout"
        app:layout_constraintEnd_toStartOf="@+id/btnCaptureLayout"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/btnCaptureLayout" />

    <ImageButton
        android:id="@+id/btnFlipCamera"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:padding="12dp"
        android:elevation="6dp"
        android:background="@drawable/bg_instagram_secondary_btn"
        android:src="@drawable/ic_flip"
        app:tint="@android:color/white"
        app:layout_constraintBottom_toBottomOf="@+id/btnCaptureLayout"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/btnCaptureLayout"
        app:layout_constraintTop_toTopOf="@+id/btnCaptureLayout" />

</androidx.constraintlayout.widget.ConstraintLayout>