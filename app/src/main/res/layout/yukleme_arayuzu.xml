<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://tools.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FAFAFA">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:clipToPadding="false">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/main"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="20dp"
            android:paddingTop="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="92dp"> <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/sol_ok"
            app:tint="#333333"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            android:contentDescription="Geri Dön" />

            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:fontFamily="sans-serif-condensed-bold"
                android:text="Yeni Kedi Ekle"
                android:textColor="#222222"
                android:textSize="18sp"
                app:layout_constraintBottom_toBottomOf="@+id/btnBack"
                app:layout_constraintStart_toEndOf="@+id/btnBack"
                app:layout_constraintTop_toTopOf="@+id/btnBack" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardPhotoContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" android:minHeight="110dp" android:layout_marginTop="16dp"
                app:cardBackgroundColor="#F5F5F5"
                app:cardCornerRadius="12dp"
                app:strokeWidth="0dp"
                app:layout_constraintTop_toBottomOf="@+id/btnBack">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:minHeight="110dp">

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/recyclerViewSelectedPhotos"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:clipToPadding="false"
                        android:orientation="horizontal"
                        android:padding="8dp"
                        android:visibility="gone"
                        tools:listitem="@layout/item_film_strip"
                        tools:visibility="visible" />

                    <LinearLayout
                        android:id="@+id/layoutPlaceholder"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <ImageView
                            android:id="@+id/geciciFoto"
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:src="@drawable/fotoyukle"
                            app:tint="#4DFF6F00" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:fontFamily="sans-serif-medium"
                            android:text="Henüz fotoğraf eklenmedi"
                            android:textColor="#757575"
                            android:textSize="13sp" />
                    </LinearLayout>
                </FrameLayout>
            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                android:id="@+id/layoutPhotoActions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal"
                app:layout_constraintTop_toBottomOf="@+id/cardPhotoContainer">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/dosya_id"
                    style="@style/Widget.Material3.Button"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:backgroundTint="#E0E0E0"
                    android:text="Galeri"
                    android:textColor="#555555"
                    android:textSize="14sp"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    app:iconPadding="4dp"
                    app:icon="@drawable/ic_gallery"
                    app:iconTint="#555555" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/kamera_id"
                    style="@style/Widget.Material3.Button"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:backgroundTint="#E0E0E0"
                    android:text="Kamera"
                    android:textColor="#555555"
                    android:textSize="14sp"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    app:iconPadding="4dp"
                    app:icon="@drawable/capture"
                    app:iconTint="#555555" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvNameLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:layout_marginStart="4dp"
                android:fontFamily="sans-serif-medium"
                android:text="İsim (Gerekli)"
                android:textColor="#222222"
                android:textSize="14sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/layoutPhotoActions" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilCatName"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:boxCornerRadiusBottomEnd="12dp"
                app:boxCornerRadiusBottomStart="12dp"
                app:boxCornerRadiusTopEnd="12dp"
                app:boxCornerRadiusTopStart="12dp"
                app:boxStrokeColor="@color/catmap_text_field_stroke_color"
                app:hintEnabled="false"
                app:helperTextEnabled="false" app:layout_constraintTop_toBottomOf="@+id/tvNameLabel">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/isimText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Örn: Tarçın, Bihter..." android:inputType="textCapWords"
                    android:textColor="#212121"
                    android:textSize="16sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:id="@+id/tvAboutLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_marginStart="4dp"
                android:fontFamily="sans-serif-medium"
                android:text="Açıklama (Opsiyonel)"
                android:textColor="#222222"
                android:textSize="14sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tilCatName" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilCatAbout"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:boxCornerRadiusBottomEnd="12dp"
                app:boxCornerRadiusBottomStart="12dp"
                app:boxCornerRadiusTopEnd="12dp"
                app:boxCornerRadiusTopStart="12dp"
                app:boxStrokeColor="@color/catmap_text_field_stroke_color"
                app:hintEnabled="false"
                app:layout_constraintTop_toBottomOf="@+id/tvAboutLabel">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/hakkindaText"
                    android:layout_width="match_parent"
                    android:layout_height="120dp"
                    android:gravity="top|start"
                    android:hint="Nerede gördünüz, durumu nasıl?..."
                    android:inputType="textMultiLine"
                    android:textColor="#212121"
                    android:textSize="15sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/kaydetmeButonu"
                style="@style/Widget.Material3.Button"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="28dp"
                android:backgroundTint="#FF6F00"
                android:fontFamily="sans-serif-condensed-bold"
                android:text="Kediyi Haritaya İşle"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                app:icon="@drawable/ic_check"
                app:iconPadding="8dp"
                app:iconSize="20dp"
                app:iconTint="#FFFFFF"
                app:cornerRadius="12dp"
                app:layout_constraintTop_toBottomOf="@+id/tilCatAbout"
                app:layout_constraintBottom_toBottomOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>

</FrameLayout>