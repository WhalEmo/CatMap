<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingVertical="6dp"
    android:paddingHorizontal="4dp">

    <!-- Profil Fotoğrafı ve Pati Rozeti Konteyneri -->
    <FrameLayout
        android:layout_width="46dp"
        android:layout_height="46dp">

        <ImageView
            android:id="@+id/iv_sender_avatar"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_cat" />

        <!-- Sağ Altta Minik Pati Rozeti -->
        <ImageView
            android:id="@+id/iv_paw_badge"
            android:layout_width="15dp"
            android:layout_height="15dp"
            android:layout_gravity="bottom|end"
            android:src="@drawable/patidolu"
            app:tint="@color/catmap_accent" />
    </FrameLayout>

    <!-- Metin Bloğu -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="2dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Kullanıcı Adı (Yarı-kalın modern tipografi) -->
            <TextView
                android:id="@+id/tv_notification_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="\@kullaniciadi"
                android:fontFamily="sans-serif-medium"
                android:textSize="14sp"
                android:textColor="@color/catmap_accent"
                android:ellipsize="end"
                android:maxLines="1" />

            <!-- "Şimdi" Rozeti -->
            <TextView
                android:id="@+id/tv_notification_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Şimdi"
                android:fontFamily="sans-serif"
                android:textSize="11sp"
                android:textColor="?android:attr/textColorSecondary" />
        </LinearLayout>

        <!-- Mesaj Özeti -->
        <TextView
            android:id="@+id/tv_notification_body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Yeni bir mesaj..."
            android:fontFamily="sans-serif"
            android:textSize="13sp"
            android:textColor="?android:attr/textColorSecondary"
            android:ellipsize="end"
            android:maxLines="1" />
    </LinearLayout>

</LinearLayout>