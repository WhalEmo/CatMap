<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_premium_dialog"
    android:orientation="vertical"
    android:padding="24dp"> <FrameLayout
    android:layout_width="match_parent"
    android:layout_height="64dp"
    android:layout_gravity="center">

    <com.google.android.material.progressindicator.CircularProgressIndicator
        android:id="@+id/dialogIconProgress"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_gravity="center"
        android:indeterminate="true"
        app:indicatorColor="#FF6F00"
        app:trackThickness="3dp" />

    <ImageView
        android:id="@+id/ivDialogSuccessCheck"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="center"
        android:src="@drawable/fotoyukle" app:tint="#FF6F00"
        android:visibility="gone" />
</FrameLayout>

    <TextView
        android:id="@+id/tvDialogStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center"
        android:fontFamily="sans-serif-medium"
        android:textColor="#1D1B20"
        android:textSize="16sp"
        android:text="Bihter buluta uçuruluyor... %0"
        android:fontFeatureSettings="tnum" /> <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/dialogProgressBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:max="100"
        android:progress="0"
        app:trackThickness="4dp" app:trackCornerRadius="2dp" app:indicatorColor="#FF6F00" app:trackColor="#1AFF6F00" /> </LinearLayout>