<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:card_view="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@null"
    android:padding="16dp">

    <androidx.cardview.widget.CardView
        android:id="@+id/fotoCardView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center"
        android:layout_marginTop="32dp"
        android:layout_marginBottom="64dp"
        card_view:cardBackgroundColor="#1A1A1A"
        card_view:cardCornerRadius="20dp"
        card_view:cardElevation="8dp"
        card_view:cardUseCompatPadding="false">

        <ImageView
            android:id="@+id/imageFullScreen"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitCenter"
            android:src="@drawable/placeholder"
            android:contentDescription="Tam ekran fotoğraf" />
    </androidx.cardview.widget.CardView>

    <TextView
        android:id="@+id/fotoSayaci"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="16dp"
        android:background="@drawable/foto_overlay_label"
        android:textColor="#FFFFFF"
        android:textSize="15sp"
        android:paddingHorizontal="16dp"
        android:paddingVertical="8dp"
        android:text="1 / 5"
        android:visibility="visible"
        android:elevation="10dp"
        android:fontFamily="sans-serif-medium"
        android:letterSpacing="0.05" />
</FrameLayout>