<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/catmap_surface_white"
    android:orientation="vertical">

    <!-- DRAG HANDLE -->
    <View
        android:layout_width="42dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_bottom_sheet_handle" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="18dp"
            android:paddingEnd="20dp"
            android:paddingBottom="24dp">

            <!-- ====================================================== -->
            <!-- HERO                                                   -->
            <!-- ====================================================== -->

            <FrameLayout
                android:layout_width="128dp"
                android:layout_height="128dp"
                android:layout_gravity="center_horizontal">

                <View
                    android:id="@+id/viewBadgeGlow"
                    android:layout_width="108dp"
                    android:layout_height="108dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_badge_detail_glow" />

                <ImageView
                    android:id="@+id/imgBadge"
                    android:layout_width="108dp"
                    android:layout_height="108dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:scaleType="fitCenter"
                    tools:src="@drawable/catmap_badge_tier_08" />

            </FrameLayout>

            <!-- MAHALLE -->
            <TextView
                android:id="@+id/tvBadgeLocation"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="6dp"
                android:fontFamily="@font/plus_jakarta_sans_medium"
                android:includeFontPadding="false"
                android:textColor="@color/catmap_text_secondary"
                android:textSize="12sp"
                tools:text="Selçuklu • Yazır Mahallesi" />

            <!-- ÜNVAN -->
            <TextView
                android:id="@+id/tvBadgeTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:fontFamily="@font/plus_jakarta_sans_bold"
                android:gravity="center"
                android:includeFontPadding="false"
                android:textColor="@color/catmap_text_primary"
                android:textSize="22sp"
                tools:text="Yazır'ın Mahalle Muhafızı" />

            <!-- ELEMENT + LEVEL -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvBadgeElement"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_badge_meta_pill"
                    android:fontFamily="@font/plus_jakarta_sans_bold"
                    android:includeFontPadding="false"
                    android:paddingHorizontal="11dp"
                    android:paddingVertical="6dp"
                    android:textSize="11sp"
                    tools:text="GECE ALTINI ROZETİ" />

                <TextView
                    android:id="@+id/tvBadgeLevel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="7dp"
                    android:background="@drawable/bg_badge_meta_pill"
                    android:fontFamily="@font/plus_jakarta_sans_bold"
                    android:includeFontPadding="false"
                    android:paddingHorizontal="11dp"
                    android:paddingVertical="6dp"
                    android:textSize="11sp"
                    tools:text="SEVİYE 8" />

            </LinearLayout>

            <!-- KISA AÇIKLAMA -->
            <TextView
                android:id="@+id/tvShortDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:fontFamily="@font/plus_jakarta_sans_bold"
                android:gravity="center"
                android:includeFontPadding="false"
                android:lineSpacingExtra="3dp"
                android:textColor="@color/catmap_text_primary"
                android:textSize="15sp"
                tools:text="Mahallenin CatMap hikâyesi artık senin izlerinle ayakta duruyor." />

            <View
                android:id="@+id/viewStoryDivider"
                android:layout_width="48dp"
                android:layout_height="2dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="18dp"
                android:layout_marginBottom="18dp"
                android:background="@color/catmap_accent" />

            <!-- ====================================================== -->
            <!-- STORY                                                  -->
            <!-- ====================================================== -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/plus_jakarta_sans_bold"
                android:includeFontPadding="false"
                android:text="Rozetin Hikâyesi"
                android:textColor="@color/catmap_text_primary"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tvBadgeStory"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="9dp"
                android:fontFamily="@font/plus_jakarta_sans"
                android:includeFontPadding="false"
                android:lineSpacingExtra="5dp"
                android:textColor="@color/catmap_text_secondary"
                android:textSize="13sp"
                tools:text="Uzun CatMap rozet hikâyesi burada gösterilecek." />

            <!-- TAGS -->
            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipGroupTags"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                app:chipSpacingHorizontal="7dp"
                app:chipSpacingVertical="7dp"
                app:singleLine="false" />

            <!-- ====================================================== -->
            <!-- NASIL YÖNETİLİR?                                      -->
            <!-- ====================================================== -->

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardBadgeHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                app:cardBackgroundColor="@color/catmap_background"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/catmap_divider"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="14dp">

                    <ImageView
                        android:id="@+id/imgMenuHint"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:contentDescription="@null"
                        android:padding="2dp"
                        android:src="@drawable/baseline_more_vert_24"
                        app:tint="@color/catmap_text_secondary" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/plus_jakarta_sans_bold"
                            android:includeFontPadding="false"
                            android:text="Rozetlerini Keşfet"
                            android:textColor="@color/catmap_text_primary"
                            android:textSize="12sp" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:fontFamily="@font/plus_jakarta_sans"
                            android:includeFontPadding="false"
                            android:text="Kazandığın rozetleri görmek veya kullandığın rozeti değiştirmek için profilindeki ⋮ menüsünden Rozetler bölümüne gidebilirsin."
                            android:textColor="@color/catmap_text_secondary"
                            android:textSize="11sp" />

                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</LinearLayout>