<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"

    android:clipToOutline="true">

    <TextView
        android:id="@+id/yorumlarBasligi"
        android:layout_width="match_parent"
        android:layout_height="45dp"
        android:text="Yorumlar"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="#000000"
        android:padding="12dp"
        android:gravity="center"
        />
    <com.google.android.material.divider.MaterialDivider
        android:id="@+id/topDivider"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:dividerColor="#E0E0E0"
        app:dividerThickness="1dp"
        app:layout_constraintTop_toBottomOf="@id/yorumlarBasligi" />

    <!-- İçerik Alanı (Arka Planda Kedi Resmi ve Yorumlar) -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- Kedi Arka Plan Resmi -->
        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleX="1.5"
            android:scaleY="1.8"
            android:alpha="0.59"
            android:src="@drawable/kediiiiler"
            android:contentDescription="@null"/>

        <!-- Liste ve Giriş Alanları -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="16dp">

            <com.facebook.shimmer.ShimmerFrameLayout
                android:id="@+id/shimmerFrameLayout"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:visibility="visible">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <include layout="@layout/item_shimmer_yorum" />
                    <include layout="@layout/item_shimmer_yorum" />
                    <include layout="@layout/item_shimmer_yorum" />
                    <include layout="@layout/item_shimmer_yorum" />
                    <include layout="@layout/item_shimmer_yorum" />
                    <include layout="@layout/item_shimmer_yorum" />
                    <include layout="@layout/item_shimmer_yorum" />

                </LinearLayout>
            </com.facebook.shimmer.ShimmerFrameLayout>


            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/yorumlarRecyclerView"
                android:layout_width="match_parent"
                android:visibility="gone"
                android:layout_height="0dp"
                android:layout_weight="1" />
            <ProgressBar
                android:id="@+id/paginationProgressBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:indeterminate="true"
                android:indeterminateTint="@color/catmap_accent"
                android:padding="8dp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/bosYorumTextView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Henüz yorum yok. İlk yorumu sen yap!"
                android:textColor="#888888"
                android:textSize="16sp"
                android:gravity="center"
                android:padding="16dp"
                android:visibility="gone"/>

            <!-- Yeni yorum ekleme alanı -->
            <LinearLayout
                android:id="@+id/yorumgndrLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:visibility="visible"
                android:paddingTop="8dp"
                android:background="@drawable/gonder_kutusu"
                android:elevation="2dp">

                <de.hdodenhof.circleimageview.CircleImageView
                    android:id="@+id/YrmgndrFotoImageView"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@drawable/kullanici"
                    android:padding="5dp" />

                <EditText
                    android:id="@+id/yorumEditText"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@null"
                    android:hint="Yorum ekle..."
                    android:maxLines="10"
                    android:padding="8dp" />

                <ImageButton
                    android:id="@+id/yorumgonder"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:background="@android:color/transparent"
                    android:scaleType="fitCenter"
                    android:layout_marginBottom="32dp"
                    android:src="@drawable/mavipati" />
            </LinearLayout>

            <!-- Yanıt ekleme alanı -->
            <LinearLayout
                android:id="@+id/yntgndrLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                android:paddingTop="8dp"
                android:background="@drawable/gonder_kutusu">

                <LinearLayout
                    android:id="@+id/carpilayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:visibility="gone"
                    android:gravity="center_vertical"
                    android:padding="8dp"
                    android:background="#DADADA">

                    <EditText
                        android:id="@+id/kimeyanit"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:hint="Yanıt veriyorsun..."
                        android:maxLines="6"
                        android:minLines="1"
                        android:background="@android:color/transparent"
                        android:textColor="@android:color/black"
                        android:textSize="14sp"
                        android:inputType="textMultiLine"
                        android:padding="8dp" />

                    <ImageButton
                        android:id="@+id/iptalButton"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:src="@android:drawable/ic_menu_close_clear_cancel"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Yanıtlamayı iptal et"
                        android:layout_marginStart="8dp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <de.hdodenhof.circleimageview.CircleImageView
                        android:id="@+id/YntgndrFotoImageView"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:src="@drawable/kullanici"
                        android:padding="5dp" />

                    <EditText
                        android:id="@+id/yntEditText"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:hint="Yanıt ekle..."
                        android:maxLines="10"
                        android:minLines="1"
                        android:padding="8dp"
                        android:background="@null"/>

                    <ImageButton
                        android:id="@+id/yntgonder"
                        android:layout_width="50dp"
                        android:layout_height="50dp"
                        android:background="@android:color/transparent"
                        android:scaleType="fitCenter"
                        android:src="@drawable/mavipati" />
                </LinearLayout>
            </LinearLayout>

        </LinearLayout>
    </FrameLayout>
</LinearLayout>