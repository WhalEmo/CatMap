<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://tools.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/catmap_background"
    tools:context=".Profil.ProfilSayfasiFragment">

    <LinearLayout
        android:id="@+id/gercekIcerikLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="visible">

        <com.google.android.material.appbar.AppBarLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:elevation="0dp">

            <com.google.android.material.appbar.MaterialToolbar
                android:id="@+id/toolbar"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                android:background="@color/catmap_surface_white"
                app:navigationIcon="?attr/homeAsUpIndicator"
                app:navigationIconTint="@color/catmap_text_primary">

                <TextView
                    android:id="@+id/gonderiBaslik"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="Gönderi"
                    android:textColor="@color/catmap_text_primary"
                    android:textSize="18sp"
                    android:textStyle="bold" />

            </com.google.android.material.appbar.MaterialToolbar>
        </com.google.android.material.appbar.AppBarLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/catmap_divider" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/catmap_background"
            android:fillViewport="true">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingBottom="24dp">

                <androidx.cardview.widget.CardView
                    android:id="@+id/fotoCardView"
                    android:layout_width="match_parent"
                    android:layout_height="320dp"
                    android:layout_marginStart="16dp"
                    android:layout_marginTop="16dp"
                    android:layout_marginEnd="16dp"
                    app:cardBackgroundColor="@color/catmap_surface_white"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="4dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">

                        <androidx.viewpager2.widget.ViewPager2
                            android:id="@+id/fotoPager"
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            android:orientation="horizontal"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />

                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/fotoIndicatorCapsule"
                            android:layout_width="wrap_content"
                            android:layout_height="14dp"
                            android:layout_marginBottom="12dp"
                            android:elevation="8dp"
                            app:cardBackgroundColor="@color/catmap_indicator_capsule"
                            app:cardCornerRadius="14dp"
                            app:cardElevation="0dp"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:strokeWidth="0dp">

                            <LinearLayout
                                android:id="@+id/fotoDotsContainer"
                                android:layout_width="wrap_content"
                                android:layout_height="match_parent"
                                android:gravity="center"
                                android:orientation="horizontal"
                                android:paddingStart="10dp"
                                android:paddingEnd="10dp" />

                        </com.google.android.material.card.MaterialCardView>

                    </androidx.constraintlayout.widget.ConstraintLayout>

                </androidx.cardview.widget.CardView>

                <ImageView
                    android:id="@+id/GonderiMenu"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginTop="16dp"
                    android:layout_marginEnd="16dp"
                    android:background="@drawable/menu_background"
                    android:clickable="true"
                    android:contentDescription="Menü"
                    android:padding="12dp"
                    android:elevation="6dp"
                    android:src="@drawable/baseline_more_vert_24"
                    app:layout_constraintEnd_toEndOf="@id/fotoCardView"
                    app:layout_constraintTop_toTopOf="@id/fotoCardView"
                    app:tint="@color/catmap_text_dark" />

                <androidx.cardview.widget.CardView
                    android:id="@+id/detayKonteynirKarti"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_marginTop="16dp"
                    android:layout_marginEnd="16dp"
                    app:cardBackgroundColor="@color/catmap_surface_white"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="2dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/fotoCardView">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="16dp">

                        <androidx.cardview.widget.CardView
                            android:id="@+id/yonlendirmeBannerKart"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:cardBackgroundColor="@color/catmap_accent_alpha_15"
                            app:cardCornerRadius="8dp"
                            app:cardElevation="0dp"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent">

                            <TextView
                                android:id="@+id/begeniBilgiTextView"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:padding="12dp"
                                android:textColor="@color/catmap_accent"
                                android:textSize="13sp"
                                android:gravity="center_vertical"
                                tools:text="🐾 Bu sevimli dostumuzu haritada görmek veya beğenmek için aşağıdaki butona tıkla!" />
                        </androidx.cardview.widget.CardView>

                        <TextView
                            android:id="@+id/kediAdiBaslik"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:text="Kedi adı:"
                            android:textColor="@color/catmap_text_primary"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@id/yonlendirmeBannerKart" />

                        <TextView
                            android:id="@+id/kediAdiText"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:textColor="@color/catmap_text_primary"
                            android:textSize="15sp"
                            app:layout_constraintBaseline_toBaselineOf="@id/kediAdiBaslik"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toEndOf="@id/kediAdiBaslik"
                            tools:text="Pamuk" />

                        <TextView
                            android:id="@+id/kediAciklamaBaslik"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:text="Açıklama:"
                            android:textColor="@color/catmap_text_primary"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@id/kediAdiBaslik" />

                        <TextView
                            android:id="@+id/kediAciklama"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:textColor="@color/catmap_text_muted"
                            android:textSize="14sp"
                            android:lineSpacingMultiplier="1.3"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@id/kediAciklamaBaslik"
                            tools:text="Kedi hakkında çok uzun bir açıklama olabilir..." />

                        <TextView
                            android:id="@+id/gonderiTarihiText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:gravity="center_vertical"
                            android:textColor="@color/catmap_text_muted"
                            android:textSize="12sp"
                            android:drawablePadding="6dp"
                            android:text="12 Mayıs 2024, 14:30"
                            app:drawableTint="@color/catmap_text_muted"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@id/kediAciklama"
                             />
                        <View
                            android:id="@+id/divider"
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginTop="16dp"
                            android:background="@color/catmap_divider"
                            app:layout_constraintTop_toBottomOf="@id/gonderiTarihiText" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/haritadaGorButon"
                            style="@style/Widget.Material3.Button.TonalButton"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:text="Haritada Gör"
                            android:textSize="14sp"
                            android:textColor="@color/catmap_accent"
                            app:backgroundTint="@color/catmap_accent_alpha_15"
                            app:icon="@drawable/ic_cat"
                            app:iconGravity="textStart"
                            app:iconTint="@color/catmap_accent"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@id/divider" />

                    </androidx.constraintlayout.widget.ConstraintLayout>
                </androidx.cardview.widget.CardView>

            </androidx.constraintlayout.widget.ConstraintLayout>
        </ScrollView>
    </LinearLayout>

</FrameLayout>